[Unit]
Description=Send hardware wallet rebalance report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/hardware_wallet_rebalancer
EnvironmentFile=%h/Projects/hardware_wallet_rebalancer/.env
ExecStart=%h/Projects/hardware_wallet_rebalancer/.venv/bin/python run_rebalancer.py --no-prompt --send-telegram
NoNewPrivileges=true
PrivateTmp=true
