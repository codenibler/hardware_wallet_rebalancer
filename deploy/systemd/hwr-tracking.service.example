[Unit]
Description=Update hardware wallet strategy performance analytics
After=network-online.target
Wants=network-online.target
OnFailure=hwr-tracking-notify.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/hardware_wallet_rebalancer
EnvironmentFile=%h/Projects/hardware_wallet_rebalancer/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/Projects/hardware_wallet_rebalancer/.venv/bin/python tracking.py --note "Daily scheduled snapshot"
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
