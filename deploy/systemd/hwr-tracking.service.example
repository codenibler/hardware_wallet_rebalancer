[Unit]
Description=Update performance analytics and check portfolio balance
After=network-online.target
Wants=network-online.target
OnFailure=hwr-tracking-notify.service

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/hardware_wallet_rebalancer
EnvironmentFile=%h/Projects/hardware_wallet_rebalancer/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/Projects/hardware_wallet_rebalancer/.venv/bin/python main.py --no-prompt
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
