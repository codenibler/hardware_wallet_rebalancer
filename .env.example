# Copy to .env. Never commit .env.
#
# IMPORTANT: generate a NEW token in BotFather. Do not reuse a token that was
# pasted into chat, an issue, a commit, or a terminal recording.
TELEGRAM_BOT_TOKEN=replace_with_new_botfather_token

# For one-shot notifications:
TELEGRAM_CHAT_ID=replace_after_running_discover_telegram

# Required by bot mode. Comma-separated numeric chat IDs allowed to run checks.
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Optional CoinGecko Demo key. The keyless public endpoint also works, but a
# Demo key generally provides more predictable limits.
COINGECKO_API_KEY=
