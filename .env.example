# Copy to .env. Never commit .env.
#
# Public wallet identifiers. Separate multiple values with commas.
HWR_BITCOIN_XPUBS=replace_with_bitcoin_account_xpub
HWR_ETHEREUM_ADDRESSES=replace_with_ethereum_receive_address
STAKED_ETHEREUM_ADDRESSES=
HWR_SOLANA_ADDRESSES=replace_with_primary_solana_receive_address
STAKED_SOLANA_ADDRESSES=

# Portfolio policy.
HWR_TARGET_BTC=0.50
HWR_TARGET_ETH=0.25
HWR_TARGET_SOL=0.15
HWR_TARGET_LINK=0.10
HWR_THRESHOLD=0.05
HWR_ESTIMATED_FEE_BPS=50
HWR_INCLUDE_UNCONFIRMED_BITCOIN=false
HWR_MAX_PRICE_AGE_SECONDS=900

# The read-only key handles account data and every dry-run preview. Give it
# view permission only. The trading key is loaded only after --confirm and
# needs view, trade, and withdrawal permissions to execute and reconcile a run.
# IP-allowlist both keys. API withdrawals bypass 2FA and email confirmation.
BITVAVO_READONLY_API_KEY=replace_with_ip_allowlisted_readonly_api_key
BITVAVO_READONLY_API_SECRET=replace_with_readonly_api_secret
BITVAVO_TRADING_API_KEY=replace_with_ip_allowlisted_trading_api_key
BITVAVO_TRADING_API_SECRET=replace_with_trading_api_secret
HWR_BITVAVO_OPERATOR_ID=101
HWR_BITVAVO_MAX_TOP_UP_EUR=1000
HWR_BITVAVO_MAX_PRICE_DEVIATION_BPS=200

# Add and verify every address in Bitvavo's address book first. Use the exact
# network identifiers offered by Bitvavo; preview mode rejects mismatches.
HWR_BITVAVO_WITHDRAW_BTC_ADDRESS=replace_with_verified_bitcoin_address
HWR_BITVAVO_WITHDRAW_BTC_NETWORK=BTC
HWR_BITVAVO_WITHDRAW_ETH_ADDRESS=replace_with_verified_ethereum_address
HWR_BITVAVO_WITHDRAW_ETH_NETWORK=ETH
HWR_BITVAVO_WITHDRAW_SOL_ADDRESS=replace_with_verified_solana_address
HWR_BITVAVO_WITHDRAW_SOL_NETWORK=SOL
HWR_BITVAVO_WITHDRAW_LINK_ADDRESS=replace_with_verified_ethereum_address_for_link
HWR_BITVAVO_WITHDRAW_LINK_NETWORK=ETH

# Public providers. Replace these defaults with private endpoints if desired.
HWR_BITCOIN_BLOCKBOOK_URL=https://btc1.trezor.io
HWR_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
HWR_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HWR_COINGECKO_URL=https://api.coingecko.com/api/v3
HWR_LINK_CONTRACT=0x514910771AF9Ca656af840dff83E8264EcF986CA

# IMPORTANT: generate a NEW token in BotFather. Do not reuse a token that was
# pasted into chat, an issue, a commit, or a terminal recording.
TELEGRAM_BOT_TOKEN=replace_with_new_botfather_token

# For one-shot notifications:
TELEGRAM_CHAT_ID=replace_after_running_discover_telegram

# Required by bot mode. Comma-separated numeric chat IDs allowed to run checks.
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Optional CoinGecko Demo key. The keyless public endpoint also works, but a
# Demo key generally provides more predictable limits.
COINGECKO_API_KEY=
